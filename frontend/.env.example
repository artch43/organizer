# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Sem estas variáveis, o app funciona só no navegador, sem login.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional: Cloudflare Turnstile (verificação anti-robô no cadastro e no login). Use a "Site Key"
# do widget; a "Secret Key" vai só no Supabase (Authentication → Attack Protection). Sem esta
# variável, a verificação fica desligada (bom para desenvolver localmente).
VITE_TURNSTILE_SITE_KEY=

# Opcional: endereço público do site, usado nos links de e-mail abertos a partir do app de celular.
VITE_SITE_URL=https://organizerapp.vercel.app
