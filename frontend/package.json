{
  "name": "organizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:app": "tsc --noEmit && APP_BUILD=1 vite build && cap sync",
    "android": "npm run build:app && cap open android",
    "ios": "npm run build:app && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@codemirror/autocomplete": "^6.18.1",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@fontsource-variable/fustat": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@lezer/highlight": "^1.2.1",
    "@react-three/fiber": "^9.8.2",
    "@shadergradient/react": "^2.4.20",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "dompurify": "^3.4.17",
    "immer": "10.1.1",
    "jszip": "^3.10.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.63.0",
    "marked": "^14.1.3",
    "motion": "^14.10.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "use-sync-external-store": "1.5.0",
    "minimatch": "^11.0.5",
    "glob": "^14.0.4"
  }
